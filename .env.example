# MapTiler public API key. Restrict allowed HTTP origins in MapTiler Cloud.
VITE_MAPTILER_KEY=
# TDX credentials are backend-only; never use a VITE_ prefix.
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
# OpenCode is called by FastAPI only; never expose this key to Vite/browser code.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1
OPENCODE_MODEL=deepseek-v4.1-flash
