# MapTiler public API key. Restrict allowed HTTP origins in MapTiler Cloud.
VITE_MAPTILER_KEY=
# TDX credentials are backend-only; never use a VITE_ prefix.
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
# OpenRouter is called by FastAPI only; never expose this key to Vite/browser code.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
